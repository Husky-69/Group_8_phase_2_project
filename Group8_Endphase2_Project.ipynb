   ],
   "source": [
    "# Calculating the Return on Investment(ROI)\n",
    "tn_movie_budgets['ROI'] = (tn_movie_budgets['worldwide_gross'] - tn_movie_budgets['production_budget']) / tn_movie_budgets['production_budget']\n",
    "tn_movie_budgets['ROI']"
   ]
